{
"update_url": "https://clients2.google.com/service/update2/crx",

  "manifest_version": 3,
  "name": "CitaExt",
  "version": "3.1.1",
  "description": "Инструмент для упрощения процесса проверки доступных записей на государственных порталах Испании.",
  "icons": {
    "16": "icon-16.png",
    "48": "icon-48.png",
    "128": "icon-128.png"
  },
  "permissions": [
    "storage",
    "webRequest",
    "tabs",
    "windows"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "https://icp.administracionelectronica.gob.es/*",
        "https://sede.administracionespublicas.gob.es/*"
      ],
      "js": ["content-helpers.js", "content.js"]
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icon-16.png",
      "48": "icon-48.png",
      "128": "icon-128.png"
    }
  },
  "host_permissions": [
    "https://icp.administracionelectronica.gob.es/*",
    "https://sede.administracionespublicas.gob.es/*"
  ]
}
